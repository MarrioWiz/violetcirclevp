<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Solo para la alerta "Pedir ayuda": se envía cuando ella confirma. -->
  <uses-permission android:name="android.permission.SEND_SMS" />

  <!-- Solo apps firmadas con la misma llave (la mini app "Pedir ayuda") pueden abrir la alerta. -->
  <permission
    android:name="mx.uvp.violetcirclevp.permission.TRIGGER_SOS"
    android:protectionLevel="signature" />

  <application>
    <!-- Entrada "Pedir ayuda" (desactivada hasta que ella la active en Ajustes). -->
    <activity
      android:name="mx.uvp.violetcirclevp.sos.SosLauncherActivity"
      android:enabled="false"
      android:exported="true"
      android:excludeFromRecents="true"
      android:label="@string/vcvp_sos_launcher_label"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Entrada protegida para la mini app (permiso de firma). -->
    <activity
      android:name="mx.uvp.violetcirclevp.sos.SosEntryActivity"
      android:exported="true"
      android:permission="mx.uvp.violetcirclevp.permission.TRIGGER_SOS"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- Botones de volumen: solo funciona si ella lo activa en Accesibilidad. -->
    <service
      android:name="mx.uvp.violetcirclevp.sos.VolumeSosService"
      android:exported="false"
      android:label="@string/vcvp_sos_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/vcvp_sos_accessibility" />
    </service>
  </application>
</manifest>

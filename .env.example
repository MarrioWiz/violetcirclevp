# Copia este archivo como .env y pega los valores de tu app web de Firebase
# (Consola de Firebase → ⚙️ Configuración del proyecto → Tus apps → app web → Config).
# Si lo dejas vacío, la app funciona igual con el contenido empaquetado (sin Firebase).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
